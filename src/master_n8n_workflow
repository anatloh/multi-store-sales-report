      "parameters": {
        "jsCode": "const allIncomingItems = $input.all();\nconst getNormalizedJson = (item) => {\n    const normalized = {};\n    if (item && item.json) {\n        Object.keys(item.json).forEach(key => {\n            normalized[key.toLowerCase()] = item.json[key];\n        });\n    }\n    return normalized;\n};\n\nconst normalizedList = allIncomingItems.map(i => getNormalizedJson(i));\nconst statsData = normalizedList.filter(json => \n    json.shoptype && (json.netsalesamount !== undefined || json.lastweeknetsales !== undefined)\n);\n\nlet allItems = [];\nnormalizedList.forEach(json => {\n    if (json.campaigns && Array.isArray(json.campaigns)) {\n        json.campaigns.forEach(camp => {\n            const normCamp = {};\n            Object.keys(camp).forEach(key => {\n                normCamp[key.toLowerCase()] = camp[key];\n            });\n            normCamp.shoptype = json.shoptype; \n            allItems.push(normCamp);\n        });\n    }\n});\n\nconst calculateNet = (amount) => Math.round(parseFloat(amount || 0) / 1.05);\n\nconst getStatsByShop = (shopType) => {\n    const filteredShops = statsData.filter(json => \n        json.shoptype && String(json.shoptype).toLowerCase() === shopType.toLowerCase()\n    );\n    \n    const totals = filteredShops.reduce((acc, curr) => {\n        acc.netsalesamount += parseFloat(curr.netsalesamount || 0);\n        acc.totaltransactions += parseFloat(curr.totaltransactions || 0);\n        acc.storedvalue += parseFloat(curr.storedvalue || curr.storedvalueamount || curr['儲值'] || 0);\n        acc.online += parseFloat(curr.online || curr.onlineamount || curr['線上點'] || 0);\n        acc.lastweeknetsales += parseFloat(curr.lastweeknetsales || 0);\n        acc.lastweektransactions += parseFloat(curr.lastweektransactions || 0);\n        acc.lastweekstoredvalue += parseFloat(curr.lastweekstoredvalue || curr.lastweekstoredvalueamount || curr['上週儲值'] || 0);\n        acc.lastweekonline += parseFloat(curr.lastweekonline || curr.lastweekonlineamount || curr['上週線上點'] || 0);\n        return acc;\n    }, { \n        netsalesamount: 0, totaltransactions: 0, storedvalue: 0, online: 0,\n        lastweeknetsales: 0, lastweektransactions: 0, lastweekstoredvalue: 0, lastweekonline: 0\n    });\n    \n    const rightTotalNetSales = totals.netsalesamount - totals.storedvalue - totals.online;\n    const revNet = calculateNet(rightTotalNetSales);\n    const guest = parseInt(totals.totaltransactions || 0, 10);\n    const avgCheck = guest > 0 ? Math.round(revNet / guest) : 0;\n    \n    const lwAmountNet = totals.lastweeknetsales;\n    const lwGuest = parseInt(totals.lastweektransactions || 0, 10);\n    const lwAvgCheck = lwGuest > 0 ? Math.round(lwAmountNet / lwGuest) : 0;\n    \n    return { revNet, guest, avgCheck, lwAmountNet, lwGuest, lwAvgCheck, totals };\n};\n\nconst dir = getStatsByShop('Direct');\nconst fran = getStatsByShop('Franchise');\n\nconst getCampaign = (campaignName, shopType) => {\n    const items = allItems.filter(json => \n        json.campaignname && \n        String(json.campaignname).toLowerCase() === campaignName.toLowerCase() && \n        json.shoptype && \n        String(json.shoptype).toLowerCase() === shopType.toLowerCase()\n    );\n    const qty = items.reduce((sum, json) => sum + parseFloat(json.campaignqty || 0), 0);\n    const amt = items.reduce((sum, json) => sum + parseFloat(json.campaignamount || 0), 0);\n    return { qty, rev: calculateNet(amt) };\n};\n\nconst now = new Date();\nconst taipeiNow = new Date(now.toLocaleString(\"en-US\", { timeZone: \"Asia/Taipei\" }));\nconst hourInt = taipeiNow.getHours();\nconst hourStr = String(hourInt).padStart(2, '0');\nconst year = taipeiNow.getFullYear();\nconst month = String(taipeiNow.getMonth() + 1).padStart(2, '0');\nconst day = String(taipeiNow.getDate()).padStart(2, '0');\nconst dateStr = `${year}/${month}/${day}`;\n\nconst formatReport = (title, stats, shopType) => {\n    const fries = getCampaign('Fries', shopType);\n    const chicken = getCampaign('Chicken', shopType);\n    const croquette = getCampaign('Croquette', shopType);\n    const combo = getCampaign('Combo', shopType);\n\n    const satayChicken = getCampaign('SatayChicken', shopType);\n    const indonesianShrimpCrackers = getCampaign('IndonesianShrimpCrackers', shopType);\n    const basilSquidBalls = getCampaign('BasilSquidBalls', shopType);\n    const satayCrispySet = getCampaign('SatayCrispySet', shopType);\n    const satayFreshSet = getCampaign('SatayFreshSet', shopType);\n    \n    const goalItem = normalizedList.find(json => json.friesdirect !== undefined);\n    \n    const satayChickenTarget = goalItem ? parseFloat(shopType === 'Direct' ? (goalItem.sataychickendirect || 0) : (goalItem.sataychickenfranchise || 0)) : 0;\n    const indonesianShrimpCrackersTarget = goalItem ? parseFloat(shopType === 'Direct' ? (goalItem.indonesianshrimpcrackersdirect || 0) : (goalItem.indonesianshrimpcrackersfranchise || 0)) : 0;\n    const basilSquidBallsTarget = goalItem ? parseFloat(shopType === 'Direct' ? (goalItem.basilsquidballsdirect || 0) : (goalItem.basilsquidballsfranchise || 0)) : 0;\n    const satayCrispySetTarget = goalItem ? parseFloat(shopType === 'Direct' ? (goalItem.sataycrispysetdirect || 0) : (goalItem.sataycrispysetfranchise || 0)) : 0;\n    const satayFreshSetTarget = goalItem ? parseFloat(shopType === 'Direct' ? (goalItem.satayfreshsetdirect || 0) : (goalItem.satayfreshsetfranchise || 0)) : 0;\n\n    const satayChickenRate = satayChickenTarget > 0 ? ((satayChicken.qty / satayChickenTarget) * 100).toFixed(1) : \"0.0\";\n    const satayChickenShare = stats.revNet > 0 ? ((satayChicken.rev / stats.revNet) * 100).toFixed(1) : \"0.0\";\n\n    const indonesianShrimpCrackersRate = indonesianShrimpCrackersTarget > 0 ? ((indonesianShrimpCrackers.qty / indonesianShrimpCrackersTarget) * 100).toFixed(1) : \"0.0\";\n    const indonesianShrimpCrackersShare = stats.revNet > 0 ? ((indonesianShrimpCrackers.rev / stats.revNet) * 100).toFixed(1) :