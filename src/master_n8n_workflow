        "jsCode": "const now = new Date();\nconst taipeiParts = new Intl.DateTimeFormat('en-US', {\n  timeZone: 'Asia/Taipei',\n  month: 'numeric',\n  day: 'numeric'\n}).formatToParts(now);\n\nconst targetMonth = parseInt(taipeiParts.find(p => p.type === 'month').value, 10);\nconst targetDay = parseInt(taipeiParts.find(p => p.type === 'day').value, 10);\n\nconst results = [];\nconst items = $input.all();\n\nfor (const item of items) {\n  const json = item.json;\n\n  const dateKey = Object.keys(json).find(key => \n    key.includes(\"115\") || key.includes(\"2026\") || \n    key.toLowerCase().includes(\"date\") || key.includes(\"日期\") ||\n    key === \" \"\n  );\n\n  const targetKey = json[\"全區49\"] !== undefined ? \"全區49\" : \n                    json[\"總\"] !== undefined ? \"總\" : \n                    Object.keys(json).find(k => k.includes(\"全區\") || k.includes(\"總\"));\n\n  if (dateKey && json[dateKey]) {\n    const rawVal = String(json[dateKey]).trim();\n    const parts = rawVal.split(/[\\/\\-]/); \n    \n    if (parts.length >= 2) {\n      const sheetMonth = parseInt(parts[parts.length - 2], 10);\n      const sheetDay = parseInt(parts[parts.length - 1], 10);\n\n      if (sheetMonth === targetMonth && sheetDay === targetDay) {\n        const rawAmount = json[targetKey] || 0;\n        item.json[\"全區49\"] = Math.round(parseFloat(rawAmount) || 0);\n        results.push(item);\n      }\n    }\n  }\n}\n\nif (results.length === 0) {\n  return [{ \n    json: { \n      \"全區49\": 0, \n      \"note\": `No target row found for ${targetMonth}/${targetDay}`,\n      \"ShopType\": \"Unknown\" \n    } \n  }];\n}\n\nreturn results;"
