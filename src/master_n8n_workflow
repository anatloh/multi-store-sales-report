        "jsCode": "const allInputs = $input.all();\n\nconst data = {\n    Direct: { RawSales: 0, ValueMoney: 0, Online: 0, Target: 0 },\n    Franchise: { RawSales: 0, ValueMoney: 0, Online: 0, Target: 0 },\n    ReportDate: \"\"\n};\n\nconst calculateNet = (raw) => Math.round(parseFloat(raw || 0) / 1.05);\n\nallInputs.forEach(item => {\n    const json = item.json;\n\n    if (json.ReportDate) {\n        data.ReportDate = json.ReportDate;\n    } else if (!data.ReportDate) {\n        const dateVal = json['2026'] || json['115.07'] || Object.values(json).find(v => \n            typeof v === 'string' && \n            v.includes('/') && \n            !v.startsWith('http') && \n            /\\d/.test(v)\n        );\n        if (dateVal) data.ReportDate = dateVal;\n    }\n\n    if (json.ShopType === 'Direct') {\n        const sales = json.NetSalesAmount !== undefined ? json.NetSalesAmount : json.DirectSales;\n        if (sales !== undefined) data.Direct.RawSales = parseFloat(sales || 0);\n\n        const money = json.StoredValue !== undefined ? json.StoredValue : json.TotalValueMoney;\n        if (money !== undefined) data.Direct.ValueMoney = parseFloat(money || 0);\n\n        const online = json.Online !== undefined ? json.Online : json.TotalOnline;\n        if (online !== undefined) data.Direct.Online = parseFloat(online || 0);\n\n        if (json.全區49 !== undefined) data.Direct.Target = parseFloat(json.全區49 || 0);\n    }\n\n    if (json.ShopType === 'Franchise') {\n        const sales = json.NetSalesAmount !== undefined ? json.NetSalesAmount : json.FranchiseSales;\n        if (sales !== undefined) data.Franchise.RawSales = parseFloat(sales || 0);\n\n        const money = json.StoredValue !== undefined ? json.StoredValue : json.TotalValueMoney;\n        if (money !== undefined) data.Franchise.ValueMoney = parseFloat(money || 0);\n\n        const online = json.Online !== undefined ? json.Online : json.TotalOnline;\n        if (online !== undefined) data.Franchise.Online = parseFloat(online || 0);\n\n        if (json.全區49 !== undefined) data.Franchise.Target = parseFloat(json.全區49 || 0);\n        else if (json.總 !== undefined) data.Franchise.Target = parseFloat(json.總 || 0);\n    }\n});\n\nconst directNetSales = calculateNet(data.Direct.RawSales - data.Direct.ValueMoney - data.Direct.Online);\nconst franchiseNetSales = calculateNet(data.Franchise.RawSales - data.Franchise.ValueMoney - data.Franchise.Online);\n\nconst calcRate = (rev, target) => {\n    return target > 0 ? ((rev / target) * 100).toFixed(1) : \"0.0\";\n};\n\nconst taipeiNow = new Date(new Date().toLocaleString(\"en-US\", { timeZone: \"Asia/Taipei\" }));\nconst hourStr = String(taipeiNow.getHours()).padStart(2, '0');\nconst defaultDateStr = `${taipeiNow.getFullYear()}/${String(taipeiNow.getMonth() + 1).padStart(2, '0')}/${String(taipeiNow.getDate()).padStart(2, '0')}`;\nconst displayDate = data.ReportDate || defaultDateStr;\n\nconst message = `${displayDate} ${hourStr}:00 營收狀況回報\\n\\n香香雞直營\\n實際營收：${directNetSales.toLocaleString()}\\n達成率：${calcRate(directNetSales, data.Direct.Target)}%\\n會員儲值：${data.Direct.ValueMoney.toLocaleString()}\\n\\n香香雞加盟\\n實際營收：${franchiseNetSales.toLocaleString()}\\n達成率：${calcRate(franchiseNetSales, data.Franchise.Target)}%\\n會員儲值：${data.Franchise.ValueMoney.toLocaleString()}`;\n\nreturn [{ json: { message } }];"
