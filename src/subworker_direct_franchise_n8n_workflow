      "parameters": {
        "operation": "executeQuery",
        "query": "DECLARE @CurrentLocalTime DATETIME = DATEADD(HOUR, 8, GETUTCDATE());\nDECLARE @TodayStart DATETIME = CAST(CAST(@CurrentLocalTime AS DATE) AS DATETIME);\nDECLARE @TodayEnd DATETIME = @CurrentLocalTime;\nDECLARE @LastWeekStart DATETIME = DATEADD(DAY, -7, @TodayStart);\nDECLARE @LastWeekEnd DATETIME = DATEADD(DAY, -7, @TodayEnd);\n\nSELECT \n    'Direct' AS ShopType,\n    t.CampaignName,\n    ISNULL(s.qty, 0) AS campaignqty,\n    ISNULL(s.amt, 0) AS campaignamount,\n    ISNULL(s.lastweek_amt, 0) AS lastweekamount\nFROM (\n    SELECT 'Fries' AS CampaignName UNION ALL\n    SELECT 'Chicken' AS CampaignName UNION ALL\n    SELECT 'Croquette' AS CampaignName UNION ALL\n    SELECT 'StudentCroquette' AS CampaignName UNION ALL\n    SELECT 'Combo' AS CampaignName UNION ALL\n    SELECT 'AutumnFood' AS CampaignName UNION ALL\n    SELECT 'SatayChicken' AS CampaignName UNION ALL\n    SELECT 'IndonesianShrimpCrackers' AS CampaignName UNION ALL\n    SELECT 'BasilSquidBalls' AS CampaignName UNION ALL\n    SELECT 'SatayFreshSet' AS CampaignName UNION ALL\n    SELECT 'SatayCrispySet' AS CampaignName UNION ALL\n    SELECT 'Mug' AS CampaignName UNION ALL\n    SELECT 'Coaster' AS CampaignName UNION ALL\n    SELECT 'MagnetSet' AS CampaignName UNION ALL\n    SELECT 'StoredValue' AS CampaignName UNION ALL\n    SELECT 'Online' AS CampaignName \n) t\nLEFT JOIN (\n    SELECT \n        v.MappedName AS CampaignName,\n        SUM(CASE WHEN d.txDate >= @TodayStart AND d.txDate <= @TodayEnd THEN d.quantity ELSE 0 END) AS qty,\n        SUM(CASE WHEN d.txDate >= @TodayStart AND d.txDate <= @TodayEnd THEN d.amount ELSE 0 END) AS amt,\n        SUM(CASE WHEN d.txDate >= @LastWeekStart AND d.txDate <= @LastWeekEnd THEN d.amount ELSE 0 END) AS lastweek_amt\n    FROM [SalesDataDB].[dbo].[DailyItemSales] d WITH (NOLOCK)\n    JOIN [SalesDataDB].[dbo].[Shop_Master] m WITH (NOLOCK) ON d.shopId = m.shopId\n    CROSS APPLY (\n        SELECT \n            CASE \n                WHEN d.itemName LIKE N'%學生證%' AND d.itemName LIKE N'%可樂餅%' THEN 'StudentCroquette'\n                WHEN d.itemName LIKE N'%薯條%' THEN 'Fries'\n                WHEN d.itemName LIKE N'%炸雞%' OR d.itemName LIKE N'%雙享雞%' THEN 'Chicken'\n                WHEN d.itemName LIKE N'%可樂餅%' THEN 'Croquette'\n                WHEN d.itemName LIKE N'%一拳超人%' OR d.itemName LIKE N'%一拳套餐%' THEN 'Combo'\n                WHEN d.itemName LIKE N'%秋日好食%' OR d.itemName LIKE N'%買一送一%' THEN 'AutumnFood'\n                WHEN (d.itemName LIKE N'%沙嗲無骨腿丁%' OR d.itemName LIKE N'%沙嗲無骨腿丁(FP)%' OR d.itemName LIKE N'%沙嗲無骨腿丁(UE)%') AND d.itemName NOT LIKE N'%(套)沙嗲無骨腿丁%' THEN 'SatayChicken'\n                WHEN (d.itemName LIKE N'%印尼蝦餅%' OR d.itemName LIKE N'%印尼蝦餅(FP)%' OR d.itemName LIKE N'%印尼蝦餅(UE)%') AND d.itemName NOT LIKE N'%(套)印尼蝦餅%' THEN 'IndonesianShrimpCrackers'\n                WHEN (d.itemName LIKE N'%九層塔炸花枝丸(泰式酸甜醬)%' OR d.itemName LIKE N'%九層塔花枝丸(FP)%' OR d.itemName LIKE N'%九層塔花枝丸(UE)%') AND d.itemName NOT LIKE N'%(套)九層塔炸花枝丸%' THEN 'BasilSquidBalls'\n                WHEN d.itemName LIKE N'%沙嗲鮮香組%' OR d.itemName LIKE N'%沙嗲鮮香組(FP)%' OR d.itemName LIKE N'%沙嗲鮮香組(UE)%' THEN 'SatayFreshSet'\n                WHEN d.itemName LIKE N'%沙嗲香脆組%' OR d.itemName LIKE N'%沙嗲香脆組(FP)%' OR d.itemName LIKE N'%沙嗲香脆組(UE)%' THEN 'SatayCrispySet'\n                WHEN d.itemName LIKE N'%馬克杯%' THEN 'Mug'\n                WHEN d.itemName LIKE N'%杯墊%' THEN 'Coaster'\n                WHEN d.itemName LIKE N'%699%磁鐵%' OR d.itemName LIKE N'%磁鐵組%' OR d.itemName LIKE N'%10款1套%' THEN 'MagnetSet'\n                WHEN d.itemName LIKE N'%儲值%' THEN 'StoredValue'\n                WHEN d.itemName LIKE N'%線上點%' THEN 'Online'\n                ELSE 'Other'\n            END AS MappedName\n    ) v\n    WHERE m.ShopType = 'Direct'\n      AND (\n          (d.txDate >= @TodayStart AND d.txDate <= @TodayEnd)\n          OR \n          (d.txDate >= @LastWeekStart AND d.txDate <= @LastWeekEnd)\n      )\n    GROUP BY v.MappedName\n) s ON t.CampaignName = s.CampaignName;"
