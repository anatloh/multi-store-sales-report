      "parameters": {
        "jsCode": "let totalNetSales = 0;\nlet totalLastWeekNetSales = 0;\nlet totalTransactionsCount = 0;\nlet totalLastWeekTransactions = 0;\nlet totalStoredValue = 0;\nlet totalLastWeekStoredValue = 0;\nlet totalOnline = 0;\nlet totalLastWeekOnline = 0;\nlet campaigns = [];\n\nconst allIncomingItems = (typeof $input !== 'undefined' && typeof $input.all === 'function') \n    ? $input.all() \n    : items;\n\nfor (let item of allIncomingItems) {\n    const data = item.json ? item.json : item;\n    if (!data) continue;\n\n    if (data.NetSalesAmount !== undefined && data.NetSalesAmount !== null) totalNetSales += Number(data.NetSalesAmount) || 0;\n    if (data.netSalesAmount !== undefined && data.netSalesAmount !== null) totalNetSales += Number(data.netSalesAmount) || 0;\n    \n    if (data.LastWeekNetSales !== undefined && data.LastWeekNetSales !== null) totalLastWeekNetSales += Number(data.LastWeekNetSales) || 0;\n    if (data.lastWeekNetSales !== undefined && data.lastWeekNetSales !== null) totalLastWeekNetSales += Number(data.lastWeekNetSales) || 0;\n    \n    if (data.TotalTransactions !== undefined && data.TotalTransactions !== null) totalTransactionsCount += Number(data.TotalTransactions) || 0;\n    if (data.totalTransactions !== undefined && data.totalTransactions !== null) totalTransactionsCount += Number(data.totalTransactions) || 0;\n    \n    if (data.LastWeekTransactions !== undefined && data.LastWeekTransactions !== null) totalLastWeekTransactions += Number(data.LastWeekTransactions) || 0;\n    if (data.lastWeekTransactions !== undefined && data.lastWeekTransactions !== null) totalLastWeekTransactions += Number(data.lastWeekTransactions) || 0;\n    \n    const cName = data.CampaignName || data.campaignName;\n    if (cName !== undefined) {\n        if (cName === 'StoredValue') {\n            totalStoredValue += Number(data.campaignamount || data.CampaignAmount) || 0;\n            totalLastWeekStoredValue += Number(data.lastweekamount || data.LastWeekAmount) || 0;\n        } else if (cName === 'Online') {\n            totalOnline += Number(data.campaignamount || data.CampaignAmount) || 0;\n            totalLastWeekOnline += Number(data.lastweekamount || data.LastWeekAmount) || 0;\n        } else if (cName !== 'Other') {\n            campaigns.push({\n                CampaignName: cName,\n                campaignqty: Number(data.campaignqty || data.CampaignQty) || 0,\n                campaignamount: Number(data.campaignamount || data.CampaignAmount) || 0\n            });\n        }\n    }\n}\n\nreturn [{\n    json: {\n        ShopType: \"Direct\",\n        NetSalesAmount: totalNetSales,\n        LastWeekNetSales: totalLastWeekNetSales,\n        TotalTransactions: totalTransactionsCount,\n        LastWeekTransactions: totalLastWeekTransactions,\n        StoredValue: totalStoredValue,\n        LastWeekStoredValue: totalLastWeekStoredValue,\n        Online: totalOnline,\n        LastWeekOnline: totalLastWeekOnline,\n        Campaigns: campaigns\n    }\n}];"
